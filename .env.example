# Rental Scout Environment Configuration
# NEVER commit real credentials or keys to source control.
# Copy this file to .env for local development.

# Application URL
APP_URL="http://localhost:3000"
NODE_ENV="development"
PORT=3000

# Authentication and location privacy secrets (generate unique random values of at least 32 characters)
AUTH_SECRET="replace_with_random_value_at_least_32_characters"
LOCATION_FUZZ_SECRET="replace_with_another_random_value_at_least_32_characters"
SESSION_SECRET="replace_with_random_value_at_least_32_characters"

# Database Configuration
DATABASE_PATH="./var/rentalscout.db"

# Payment Gateway Configuration (provider integration currently disabled until credentials/API setup are verified)
PAYMENT_PROVIDER="disabled"
PAYMENT_CURRENCY="UGX"
UNLOCK_FEE_UGX=5000
MAX_UNLOCKS_PER_DAY=15
PAYMENT_WEBHOOK_SECRET="your_payment_webhook_hmac_secret"

# MTN Mobile Money API (Uganda)
MTN_MOMO_API_KEY="your_mtn_momo_api_key"
MTN_MOMO_API_SECRET="your_mtn_momo_api_secret"
MTN_MOMO_SUBSCRIPTION_KEY="your_mtn_momo_subscription_key"
MTN_MOMO_TARGET_ENV="sandbox"

# Airtel Money API (Uganda)
AIRTEL_API_KEY="your_airtel_money_api_key"
AIRTEL_API_SECRET="your_airtel_money_api_secret"
AIRTEL_CLIENT_ID="your_airtel_client_id"

# Google Maps (browser key is public; restrict by HTTP referrer and API)
VITE_GOOGLE_MAPS_API_KEY=""
VITE_GOOGLE_MAPS_MAP_ID=""
MAP_EXACT_REQUIRES_UNLOCK=true

# Storage Service for Media (Images/Videos)
STORAGE_PROVIDER="local"
STORAGE_API_KEY="your_storage_api_key"
STORAGE_API_SECRET="your_storage_api_secret"
STORAGE_BUCKET="rentalscout-media"

# Communications (configure only after selecting a documented provider)
SMS_PROVIDER="disabled"
SMS_API_KEY=""
SMS_USERNAME=""
SMS_SENDER_ID=""
